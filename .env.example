# API-GEN-AUTO — exemple de configuration
# Copier vers .env et adapter (ne jamais commiter .env).

# Profil Spring : dev (H2 local) ou prod (Oracle)
APIGEN_PROFILE=dev

# Base de données (profil prod / Oracle)
APIGEN_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
APIGEN_DB_USER=apigen
APIGEN_DB_PASSWORD=change-me
APIGEN_DB_POOL_MAX=15

# Secrets — OBLIGATOIRE en production
# JWT : chaîne aléatoire d'au moins 64 caractères.
APIGEN_JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
APIGEN_JWT_EXPIRATION_HOURS=8
# Chiffrement des identifiants de connexions (AES-256-GCM).
APIGEN_CRYPTO_KEY=replace-with-a-long-random-crypto-key

# CORS du studio Angular
APIGEN_CORS_ORIGINS=http://localhost:4200,https://studio.example.com

# Planificateur
APIGEN_SCHEDULER_ENABLED=true
APIGEN_SCHEDULER_POLL_MS=15000

# Répertoire des échanges de fichiers
APIGEN_FILES_BASE_DIR=./data/exchanges

# Jeu de démonstration (désactiver en production)
APIGEN_SEED_DEMO=false

# Rétention d'audit (jours)
APIGEN_AUDIT_RETENTION_DAYS=90
