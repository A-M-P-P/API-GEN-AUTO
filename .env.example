# =====================================================================
# API-GEN — modèle d'environnement de PRODUCTION
# Copier vers .env, remplacer A_REMPLACER, puis exporter les variables
# (ou les déclarer dans le service systemd / le jeu de variables Tomcat).
# Ne jamais committer le fichier .env rempli.
# Le profil par défaut du code reste "dev" : il faut bien définir prod ici.
# =====================================================================

APIGEN_PROFILE=prod

# --- Backend : base de la plateforme (H2 uniquement avec APIGEN_PROFILE=local) ---
APIGEN_DB_URL=jdbc:oracle:thin:@//SERVEUR_ORACLE:1521/SERVICE
APIGEN_DB_USER=APIGEN
APIGEN_DB_PASSWORD=APIGEN1234
APIGEN_DB_POOL_MAX=15

# --- Fichiers externes (obligatoire si le WAR est lancé depuis Tomcat) ---
APIGEN_RUNTIME_CONFIG=/opt/apigen/config/runtime.properties
# Mot de passe initial ; à changer dès la première connexion en production.
APIGEN_ADMIN_PASSWORD=Admin2026!

# --- Secrets ---
APIGEN_JWT_SECRET=A_REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_D_AU_MOINS_64_CARACTERES
APIGEN_JWT_EXPIRATION_HOURS=8
APIGEN_CRYPTO_KEY=A_REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE

# --- URL et CORS ---
# Origine du studio (WebLogic / Apache / XAMPP-WAMP) autorisée à appeler le backend.
APIGEN_CORS_ORIGINS=http://studio.example.com

# --- Fonctionnement ---
APIGEN_SCHEDULER_ENABLED=true
APIGEN_SCHEDULER_POLL_MS=30000
APIGEN_AUDIT_RETENTION_DAYS=90
APIGEN_FILES_BASE_DIR=/opt/apigen/data/exchanges
APIGEN_JDBC_POOL_EVICT_MS=300000
APIGEN_SEED_DEMO=false

# --- Studio (frontend statique) : voir config.json déployé à côté de index.html ---
#BACKEND_URL=http://tomcat.example.com:8080/apigen
#CONTEXT_PATH=
