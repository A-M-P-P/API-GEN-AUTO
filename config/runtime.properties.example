# =====================================================================
# API-GEN — configuration externe du BACKEND (aucun rebuild nécessaire)
# Copier vers : /opt/apigen/config/runtime.properties
# Le backend doit connaître ce chemin AVANT le démarrage :
#   export APIGEN_RUNTIME_CONFIG=/opt/apigen/config/runtime.properties
# Profil : APIGEN_PROFILE=prod (à définir avant le démarrage, pas ici).
# Remplacer toutes les valeurs A_REMPLACER. Ne jamais committer le fichier rempli.
# =====================================================================

# --- Base de données DE LA PLATEFORME (utilisateurs, API, exécutions, audit) ---
# Créer d’abord le compte/schéma APIGEN avec database/oracle/create-apigen-schema.sql.
# Ne pas utiliser le compte d’un système métier.
# La base H2 n'est utilisée qu'avec le profil "local". En prod, utilisez Oracle.
spring.datasource.url=jdbc:oracle:thin:@//SERVEUR_ORACLE:1521/SERVICE
spring.datasource.username=APIGEN
spring.datasource.password=A_REMPLACER

# --- Serveur ---
# Ces deux clés ne s'appliquent qu'au JAR autonome. Dans Tomcat/WebLogic, le port et
# le préfixe sont fixés par le serveur (nom du WAR : apigen.war -> /apigen).
#server.port=8080
#server.servlet.context-path=/apigen

# --- Sécurité (OBLIGATOIRE en production) ---
apigen.jwt.secret=A_REMPLACER_PAR_UNE_CHAINE_ALEATOIRE_D_AU_MOINS_64_CARACTERES
apigen.jwt.expiration-hours=8
apigen.crypto.key=A_REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
apigen.cors.allowed-origins=http://studio.example.com

# --- Fonctionnement ---
apigen.scheduler.enabled=true
apigen.scheduler.poll-interval-ms=30000
apigen.audit.retention-days=90
apigen.files.base-dir=/opt/apigen/data/exchanges
apigen.seed.demo=false

# --- Premier compte administrateur (uniquement si la base est vide) ---
apigen.seed.admin-username=admin
# Soit ici, soit APIGEN_ADMIN_PASSWORD dans l'environnement (pas les deux).
# Valeur initiale ; à changer dès la première connexion en production.
apigen.seed.admin-password=Admin2026!

# --- Connexions des pipelines (systèmes cibles) ---
apigen.seed.connections-file=/opt/apigen/config/connections.json
